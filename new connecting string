const sql = require("mssql/msnodesqlv8");

const config = {
  server: "localhost\\SQLEXPRESS",
  database: "MyApp",
  options: {
    trustedConnection: true,
    trustServerCertificate: true
  }
};

sql.connect(config)
  .then(() => {
    console.log("Connected to SQL Server!");
  })
  .catch(err => {
    console.error("SQL connection failed:", err);
  });
